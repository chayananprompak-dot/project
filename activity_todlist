<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/checklist_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/checklist_color_bg">

    <LinearLayout
        android:id="@+id/checklist_layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/checklist_color_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/checklist_tv_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bakery Checklist 🥐"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/checklist_color_header_title" />

                    <TextView
                        android:id="@+id/checklist_tv_header_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="งานอบขนมและเตรียมครัววันนี้"
                        android:textSize="13sp"
                        android:textColor="@color/checklist_color_header_sub" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/checklist_color_primary_light">

                    <TextView
                        android:id="@+id/checklist_tv_task_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 งานค้าง"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/checklist_color_primary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/checklist_card_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/checklist_color_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">


                <EditText
                    android:id="@+id/checklist_et_task_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="เพิ่มรายการใหม่ในครัว..."
                    android:textColorHint="@color/checklist_color_hint"
                    android:textColor="@color/checklist_color_header_title"
                    android:textSize="14sp"
                    android:paddingVertical="12dp"
                    android:inputType="textCapSentences" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/checklist_btn_add_inline"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/checklist_color_primary">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/checklist_color_white"
                        android:contentDescription="เพิ่มรายการ" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="รายการงานทั้งหมด"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/checklist_color_header_title" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/checklist_rv_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            tools:listitem="@android:layout/simple_list_item_multiple_choice" />

    </LinearLayout>


    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/checklist_fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="เพิ่มงาน"
        android:textColor="@color/checklist_color_white"
        android:textStyle="bold"
        android:contentDescription="เพิ่มงาน"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/checklist_color_white"
        app:backgroundTint="@color/checklist_color_primary"
        app:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
